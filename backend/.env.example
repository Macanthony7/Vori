# Copy to backend/.env and fill in. Read by chain_client.py (watcher). Never commit .env.
# Details: docs/setup.md#providers

# BTC / LTC / DOGE. Optional, but without it BlockCypher allows ~100 requests/hour.
BLOCKCYPHER_TOKEN=

# Full JSON-RPC URLs, key included (e.g. Alchemy, Ankr, QuickNode, Infura).
# Must serve balances at recent past blocks (standard for any full node, last 128 blocks).
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BSC_RPC_URL=https://rpc.ankr.com/bsc/YOUR_KEY

# Sepolia test network (only used with GATEWAY_TESTNETS=1). Any Sepolia JSON-RPC URL works.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Tron. The key is optional but raises TronGrid's rate limit.
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=
# Tron Nile testnet (only used with GATEWAY_TESTNETS=1). The key above is never sent here.
# NILE_TRONGRID_URL=https://nile.trongrid.io

# Public base URL of this server, used for `checkout_url` in payment responses (default http://localhost:8000)
# GATEWAY_PUBLIC_URL=https://pay.example.com

# Optional: SQLite path (default backend/gateway.db)
# GATEWAY_DB=

# Development only: allow http:// and private/loopback webhook URLs. Never set in production.
# GATEWAY_ALLOW_PRIVATE_WEBHOOKS=1

# Development only: show test networks (Sepolia) for payments, balances and sending.
# Test coins have no value. Never set in production.
# GATEWAY_TESTNETS=1
